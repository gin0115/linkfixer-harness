{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/?lfh_go=mixed-links",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/a8cteam51/internet-archive-wayback-machine-link-fixer/releases/download/1.5.0-RC1/internet-archive-wayback-machine-link-fixer.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/gin0115/linkfixer-harness",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "linkfixer-harness"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; \\LinkFixer_Harness\\Scenario_Mixed_Links::seed();"
		}
	]
}
