{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/a8cteam51/internet-archive-wayback-machine-link-fixer/releases/download/1.5.0-RC1/internet-archive-wayback-machine-link-fixer.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/gin0115/linkfixer-harness/main/zips/core.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/gin0115/linkfixer-harness/main/zips/permissions.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; if ( ! username_exists( 'editor' ) ) { wp_insert_user( array( 'user_login' => 'editor', 'user_pass' => wp_generate_password(), 'user_email' => 'editor@harness.test', 'role' => 'editor' ) ); } \\LinkFixer_Harness\\Scenarios::get( 'permissions' )->seed();"
		},
		{
			"step": "login",
			"username": "editor"
		}
	]
}
